# Copy to .env and fill in. Never commit .env.
# Domain Caddy serves and gets an HTTPS certificate for
DOMAIN=mvmpatron.pl
# Redirected to DOMAIN; leave unset while testing on a subdomain
WWW_DOMAIN=www.mvmpatron.pl
# Test site, where every merge to main appears before it is published
TEST_DOMAIN=test.mvmpatron.pl
# Login for the test site: user name, and the bcrypt hash of the password in single quotes.
# Make the hash with: docker compose exec -T caddy caddy hash-password --plaintext 'your-password'
TEST_AUTH_USER=mvm
# TEST_AUTH_HASH='$2a$14$...'

# Gemini API key for the AI chat (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Gemini model used by the chat
# GEMINI_MODEL=gemini-3-flash-preview
# Images to run; the workflows set these. TEST_IMAGE: "Build and deploy" (merge to main).
# IMAGE: "Publish to production", which copies TEST_IMAGE.
# TEST_IMAGE=ghcr.io/71adaml/mvmpatron-web:latest
# IMAGE=ghcr.io/71adaml/mvmpatron-web:latest
