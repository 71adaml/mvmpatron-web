# Copy to .env and fill in. Never commit .env.
# Domain Caddy serves and gets an HTTPS certificate for
DOMAIN=mvmpatron.pl
# Redirected to DOMAIN; leave unset while testing on a subdomain
WWW_DOMAIN=www.mvmpatron.pl
# Gemini API key for the AI chat (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Gemini model used by the chat
# GEMINI_MODEL=gemini-3-flash-preview
# Image to run; the deploy workflow sets this to the commit it deploys
# IMAGE=ghcr.io/71adaml/mvmpatron-web:latest
